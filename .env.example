# AttendWise AI — Environment Configuration Example
# Copy this file to .env before starting services

# Application & Ports
NODE_ENV=development
PORT_CORE_API=3001
PORT_WORKFLOW_WORKER=3002
PORT_AI_SERVICE=8000
PORT_WEB=3000

# URLs
CORE_API_URL=http://localhost:3001
WORKFLOW_WORKER_URL=http://localhost:3002
AI_SERVICE_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Database (PostgreSQL)
# For local Docker: postgresql://postgres:postgrespassword@localhost:5432/attendwise_db?schema=public
# For SQLite dev fallback: file:./dev.db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/attendwise_db?schema=public

# Qdrant Vector DB
# For Docker: http://localhost:6333
# AI service also supports embedded/in-memory mode if QDRANT_URL is set to :memory:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Inngest Durable Orchestration
INNGEST_EVENT_KEY=local-dev-event-key
INNGEST_SIGNING_KEY=local-dev-signing-key
INNGEST_BASE_URL=http://localhost:8288

# AI Service Configuration
# LLM_PROVIDER options: mock | groq | openai | anthropic
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key-here          # Get free key: console.groq.com
LLM_MODEL=llama-3.3-70b-versatile           # or: llama-3.1-8b-instant  mixtral-8x7b-32768
EMBEDDING_PROVIDER=mock                      # Groq has no embedding API — keep mock or use openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Security & Internal Tokens
INTERNAL_SERVICE_TOKEN=dev-secret-internal-service-token-1234
JWT_SECRET=dev-jwt-super-secret-key-attendwise-ai

# Storage
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./uploads
