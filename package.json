{
  "name": "attendwise-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web,ai\" -c \"blue,green,magenta\" \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:ai\"",
    "dev:all": "concurrently -k -n \"api,worker,web,ai\" -c \"blue,yellow,green,magenta\" \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\" \"npm run dev:ai\"",
    "dev:api": "npm --workspace=@attendwise/core-api run dev",
    "dev:worker": "npm --workspace=@attendwise/workflow-worker run dev",
    "dev:web": "npm --workspace=@attendwise/web run dev",
    "dev:ai": "apps\\ai-service\\.venv\\Scripts\\uvicorn.exe app.main:app --app-dir apps/ai-service --port 8000",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm --workspace=@attendwise/core-api run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
